{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBVE Launcher",
  "version": "0.1.0",
  "identifier": "com.openbve.launcher",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenBVE Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1050,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
