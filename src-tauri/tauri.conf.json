{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRail",
  "version": "0.1.0",
  "identifier": "com.dannyiswandyy.openrail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenRail",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.local"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Simulation",
    "shortDescription": "Independent OpenBVE-compatible railway simulation platform"
  }
}
