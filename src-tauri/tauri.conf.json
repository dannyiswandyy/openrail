{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRail",
  "version": "1.0.0",
  "identifier": "com.dannyiswandyy.openrail",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenRail — OpenBVE Launcher",
        "width": 1360,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
