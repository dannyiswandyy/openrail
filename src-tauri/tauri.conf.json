{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRail",
  "version": "1.2.0",
  "identifier": "com.dannyiswandyy.openrail",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenRail — OpenBVE Platform",
        "width": 1360,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "OpenBVE-compatible launcher, content manager and validation platform",
    "category": "Simulation"
  }
}
